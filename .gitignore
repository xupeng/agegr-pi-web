# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
/.agents/
/skills-lock.json

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.factory
# local tooling
.codegraph/

# pi-web runtime attachments & local packages
.pi-web/
*.tgz
e2e_*.mjs

# Personal Trellis development framework: keep files local, not in Git.
/.trellis/
/.agents/skills/trellis-*/
/.pi/agents/trellis-*
/.pi/prompts/trellis-*
/.pi/extensions/trellis/
/.pi/settings.json
# Currently contains only the local Trellis journal merge rule.
/.gitattributes
