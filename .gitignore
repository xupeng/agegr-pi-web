# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
/.agents/
/skills-lock.json

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.factory
# local tooling
.codegraph/

# pi-web runtime attachments & local packages
.pi-web/
*.tgz
e2e_*.mjs

# Raw task verification outputs: retain privately; commit Markdown summaries.
# Task metadata/manifests and product/test fixture JSON are outside this scope.
.trellis/tasks/**/research/**/*.log
.trellis/tasks/**/research/**/*.stderr
.trellis/tasks/**/research/**/*.jsonl
.trellis/tasks/**/research/**/*.png
.trellis/tasks/**/research/**/*.jpg
.trellis/tasks/**/research/**/*.jpeg
.trellis/tasks/**/research/**/*.webp
.trellis/tasks/**/research/**/*.gif
.trellis/tasks/**/research/**/*.zip
.trellis/tasks/**/research/**/*.gz
.trellis/tasks/**/research/**/*.webm
.trellis/tasks/**/research/**/*.mp4
.trellis/tasks/**/research/**/*-browser-*/**/*.json
.trellis/tasks/**/research/**/browser-results/**/*.json
.trellis/tasks/**/research/**/validation-logs/**/*.json
.trellis/tasks/**/research/**/*eslint*.json
.trellis/tasks/**/research/**/tsc-results.json
.trellis/tasks/**/research/**/report.json
!.trellis/tasks/**/research/**/task.json
